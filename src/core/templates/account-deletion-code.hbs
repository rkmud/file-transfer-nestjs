<!doctype html>
<html lang="en">
  <body style="margin: 0; padding: 24px; background: #f4f5f7; font-family: Arial, Helvetica, sans-serif; color: #1f2933;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width: 480px; margin: 0 auto; background: #ffffff; border-radius: 8px;">
      <tr>
        <td style="padding: 32px;">
          <h1 style="margin: 0 0 16px; font-size: 20px;">Confirm account deletion</h1>
          <p style="margin: 0 0 16px; font-size: 14px; line-height: 20px;">
            Hello, {{name}}!
          </p>
          <p style="margin: 0 0 24px; font-size: 14px; line-height: 20px;">
            A request was made to permanently delete your account. This action
            cannot be undone. To confirm the deletion, enter the code below:
          </p>
          <p style="margin: 0 0 24px; font-size: 32px; font-weight: bold; letter-spacing: 8px; text-align: center;">
            {{code}}
          </p>
          <p style="margin: 0 0 16px; font-size: 13px; color: #616e7c;">
            The code is valid for {{minutesLeft}} minutes.
          </p>
          <p style="margin: 0; font-size: 13px; color: #616e7c;">
            If you did not request this, change your password and contact support immediately.
          </p>
        </td>
      </tr>
    </table>
  </body>
</html>
