# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_VERIFICATION_EXPIRES_IN=1h

RBAC_CACHE_TTL_SECONDS=30

OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=File Transfer <noreply@localhost>
MAIL_SECURE=false