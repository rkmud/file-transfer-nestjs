# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_VERIFICATION_EXPIRES_IN=1h

RBAC_CACHE_TTL_SECONDS=30

OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=File Transfer <noreply@localhost>
MAIL_SECURE=false

UPLOADS_DIR=uploads
UPLOADS_PUBLIC_PREFIX=/static
AVATAR_MAX_BYTES=5242880

CONVERSION_STORAGE_DIR=storage/conversions
CSV_MAX_SIZE=10485760
JSON_MAX_SIZE=10485760
XML_MAX_SIZE=10485760
YAML_MAX_SIZE=5242880
CONVERSION_TIMEOUT_MS=30000
CONVERSION_MAX_DEPTH=100
CONVERSION_MAX_NODES=1000000
CONVERSION_MAX_YAML_ALIASES=100
CONVERSION_WORKER_THREADS=
CONVERSION_WORKER_MAX_HEAP_MB=512

PNG_MAX_SIZE=20971520
JPEG_MAX_SIZE=20971520
SVG_MAX_SIZE=10485760
MAX_RASTER_WIDTH=4096
MAX_RASTER_HEIGHT=4096
IMAGE_MAX_INPUT_PIXELS=50000000
IMAGE_CONVERSION_TIMEOUT_MS=30000
IMAGE_WORKER_THREADS=
IMAGE_WORKER_MAX_HEAP_MB=512
